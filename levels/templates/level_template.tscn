[node name="LevelTemplate" type="Node2D"]
editor_description = "正式空白关卡模板。先画 Terrain，再画 LegalArea、Wall、Decoration；普通绘制使用底部“图块”页签。"

[node name="TerrainLayer" type="TileMapLayer" parent="."]
editor_description = "关卡内格与不规则地图边界。有 Tile=关卡内，无 Tile=关卡外，允许内部空洞。"
tile_set = ExtResource("1_terrain")

[node name="WallLayer" type="TileMapLayer" parent="."]
editor_description = "Terrain 内普通静态墙体，不要绘制到 Terrain 外。"
tile_set = ExtResource("2_wall")

[node name="LegalAreaLayer" type="TileMapLayer" parent="."]
editor_description = "Terrain 内允许玩家放置机关的格子子集，不要绘制到 Terrain 外。"
tile_set = ExtResource("3_legal")

[node name="DecorationLayer" type="TileMapLayer" parent="."]
editor_description = "纯视觉装饰，不参与边界、阻挡或放置判断。"
tile_set = ExtResource("4_decoration")

[node name="RuntimeObjects" type="Node2D" parent="."]

[node name="Emitter" parent="RuntimeObjects" instance=ExtResource("5_emitter")]
position = Vector2(96, 224)

[node name="BasicCrystal" parent="RuntimeObjects" instance=ExtResource("6_crystal")]
